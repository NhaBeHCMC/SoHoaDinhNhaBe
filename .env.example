NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dùng ở trình duyệt để tạo URL phân phối ảnh. Không phải thông tin bí mật.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_ASSET_FOLDER=nha-be/di-tich-phu-xuan

# Chỉ dùng bởi scripts/upload-to-cloudinary.mjs. Không đưa API secret lên client.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=nha-be/di-tich-phu-xuan
